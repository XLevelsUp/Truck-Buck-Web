{
  "name": "@truckbuck/types",
  "version": "0.0.0",
  "private": true,
  "description": "Shared domain types and Zod schemas. Runtime dependency: zod only.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
