{
  "name": "truckbuck-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": ">=12.16.1"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:marketing": "turbo run dev --filter=@truckbuck/marketing",
    "dev:admin": "turbo run dev --filter=@truckbuck/admin",
    "build": "turbo run build",
    "lint": "turbo run lint lint:deps",
    "lint:deps": "depcruise apps packages --config .dependency-cruiser.cjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node scripts/clean.mjs",
    "setup:env": "node scripts/setup-env.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@truckbuck/config-eslint": "workspace:*",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
