# npm-compatible settings only (registry, auth, proxies).
#
# Peer-dependency strictness, engine strictness and build-script policy are
# pnpm-specific settings. Since pnpm 11 they are read ONLY from
# pnpm-workspace.yaml, so they live there:
#
#   strictPeerDependencies: true   -> missing/incompatible peers fail install
#   autoInstallPeers: false        -> peers must be declared explicitly
#   engineStrict: true             -> wrong Node/pnpm version fails install
#
# If you hit a peer error: fix the version (usually in the `catalog:` block of
# pnpm-workspace.yaml). Do not loosen strictness; if a third-party package has
# a wrong peer range, add a scoped `peerDependencyRules.allowedVersions` entry
# in pnpm-workspace.yaml with a comment linking the upstream issue.

registry=https://registry.npmjs.org/
