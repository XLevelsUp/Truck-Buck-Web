# Copy to .env.local (or run `pnpm setup:env` from the repo root).
# VITE_* values are PUBLIC: Vite inlines them into the JS bundle at build time.
# Never put secrets here.

# Base URL of the TruckBuck API (future apps/api, NestJS).
VITE_API_BASE_URL=http://localhost:4000/v1

# One of: development | test | staging | production
VITE_APP_ENV=development
