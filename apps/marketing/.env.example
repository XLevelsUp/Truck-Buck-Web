# Copy to .env.local (or run `pnpm setup:env` from the repo root).
# Both values are PUBLIC: they are inlined into the client bundle at build time.
# Never put secrets in NEXT_PUBLIC_* variables.

# Canonical origin of the marketing site, no trailing slash. Used for canonical
# URLs, sitemap, robots and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Play listing for the TruckBuck driver app.
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=in.truckbuck.driver
