# Copy to .env.local (or run `pnpm setup:env` from the repo root).
# Both values are PUBLIC: they are inlined into the client bundle at build time.
# Never put secrets in NEXT_PUBLIC_* variables.

# Canonical origin of the marketing site, no trailing slash. Used for canonical
# URLs, sitemap, robots and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Play listing for the TruckBuck driver app.
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=in.truckbuck.driver

# --- Optional public settings ------------------------------------------------
# WhatsApp Business number for click-to-chat: 91 + 10 digits, no "+".
# Unset = WhatsApp buttons are hidden.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Cloudflare Turnstile site key (public). Production widget: 0x4AAAAAAGRF0fvcTEu9UnxC
# — set it in Vercel Production, NOT here: the real key only works on the
# hostnames listed on the widget, so localhost/e2e would fail. Unset outside
# production = Cloudflare's always-pass test key. REQUIRED for production deploys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Maps Embed API key (restrict by HTTP referrer to truckbuck.in) for the
# tap-to-open interactive route map. Unset = "Open in Google Maps" link only.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) ---------------------
# Supabase. The site uses the PUBLISHABLE key (RLS: read public content only)
# plus a site secret that unlocks the site_* write functions (leads, rate
# limits, distance cache, web vitals). NEVER set a secret/service-role key
# here — the build refuses to start. See SECURITY.md.
# Generate the site secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# then register its hash once (Supabase SQL editor): select private.set_site_secret('<secret>');
# All three unset = bundled sample data (dev only), leads are not saved.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SITE_SECRET=
# Google Maps Platform key with Places API (New), Routes API, Geocoding API
# and Maps Static API enabled; restrict by API. Unset = offline sample
# provider (cities from service_areas, straight-line distance) — dev only.
GOOGLE_MAPS_API_KEY=
# Cloudflare Turnstile secret (dashboard → Turnstile → the widget → Settings).
# Unset outside production = test secret. With a real secret, the server also
# checks each token's `action` and `hostname` (src/server/abuse.ts).
TURNSTILE_SECRET_KEY=
# Hostnames tokens may come from, comma-separated. Default: the host of
# NEXT_PUBLIC_SITE_URL (+ www) and this Vercel deployment's URLs. Must match
# the widget's hostname list in Cloudflare. Never include localhost in production.
TURNSTILE_HOSTNAMES=
# Salt for hashing IPs in rate-limit keys. Any long random string.
RATE_LIMIT_SALT=
# Use is_sample rows (placeholder trucks, rates, cities)? Defaults to true for
# `next dev`, false for production builds. Set true on Vercel Preview only.
ALLOW_SAMPLE_DATA=true

# WhatsApp Business Cloud API (Meta) for the automatic "application received"
# message to transporters. All three or none; unset = acknowledgement skipped
# (the confirmation screen still offers a one-tap WhatsApp chat).
# The template needs one body parameter: {{1}} = application reference.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TRANSPORTER_TEMPLATE=

# Serve Hindi/Tamil pages that haven't had native-speaker review yet?
# Default: yes for `next dev`, no for production builds. Set true on Vercel
# Preview (and locally for e2e) so reviewers can read them; NEVER on Production.
PREVIEW_UNREVIEWED_LOCALES=true

# --- Monitoring (server-only) ------------------------------------------------
# Sentry DSN for server errors (and browser errors forwarded through
# /api/client-errors). No PII is sent: see src/server/sentry.ts. Unset = off.
SENTRY_DSN=
# Defaults to VERCEL_ENV (production / preview) or "development".
SENTRY_ENVIRONMENT=

# --- Analytics & A/B tests (public) ------------------------------------------
# Google Tag Manager container. Loaded ONLY after the visitor accepts analytics
# cookies. Production: GTM-5TQTVZXH. Unset = no GTM, no consent banner.
NEXT_PUBLIC_GTM_ID=
# A/B tests to run (src/lib/ab.ts): hero,cta,widget_order,primary_action
# Unset = everyone sees the control. QA: add ?exp=hero:b to force a variant.
NEXT_PUBLIC_EXPERIMENTS=

# --- Lead alerts & reporting (server-only) -----------------------------------
# Ops alerts on WhatsApp (needs WHATSAPP_CLOUD_TOKEN/PHONE_NUMBER_ID above).
# Approved template names (docs/analytics.md §6) and ops numbers (+91…, comma-separated).
WHATSAPP_OPS_TEMPLATE=
WHATSAPP_ACK_TEMPLATE=
WHATSAPP_OPS_NUMBERS=
# Resend (https://resend.com): API key, verified sender, ops alert inbox(es)
# and weekly-summary recipients (comma-separated). Unset = emails skipped.
RESEND_API_KEY=
EMAIL_FROM="TruckBuck Leads <leads@truckbuck.in>"
OPS_EMAILS=
SUMMARY_EMAILS=
# Google Sheet lead log: Apps Script web-app URL + shared secret
# (docs/integrations/lead-sheet.gs). Unset = no Sheet rows.
SHEET_WEBHOOK_URL=
SHEET_WEBHOOK_SECRET=
# GA4 Measurement Protocol for server-side conversions (only with consent).
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
# Vercel Cron bearer secret for /api/cron/weekly-summary (Vercel sends it).
CRON_SECRET=

# --- Search engine verification (public meta tags, not secrets) ---------------
# Google Search Console → Settings → Ownership verification → HTML tag: paste
# only the content="…" value. Bing Webmaster Tools → XML file/meta tag: the
# msvalidate.01 value. Leave empty to omit the tags.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
