{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
      "env": ["NEXT_PUBLIC_*", "BUILD_STANDALONE"]
    },
    "typecheck": {
      "env": ["NEXT_PUBLIC_*"]
    },
    "dev": {
      "passThroughEnv": ["NEXT_PUBLIC_*"]
    },
    "test:e2e": {
      "env": ["NEXT_PUBLIC_*"]
    }
  }
}
