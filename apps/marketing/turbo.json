{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
      "env": [
        "NEXT_PUBLIC_*",
        "BUILD_STANDALONE",
        "VERCEL_ENV",
        "VERCEL_URL",
        "VERCEL_BRANCH_URL",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "SUPABASE_URL",
        "SUPABASE_PUBLISHABLE_KEY",
        "SUPABASE_SITE_SECRET",
        "SUPABASE_SECRET_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",
        "SENTRY_DSN",
        "SENTRY_ENVIRONMENT",
        "GOOGLE_MAPS_API_KEY",
        "TURNSTILE_SECRET_KEY",
        "TURNSTILE_HOSTNAMES",
        "RATE_LIMIT_SALT",
        "ALLOW_SAMPLE_DATA",
        "WHATSAPP_CLOUD_TOKEN",
        "WHATSAPP_PHONE_NUMBER_ID",
        "WHATSAPP_TRANSPORTER_TEMPLATE",
        "PREVIEW_UNREVIEWED_LOCALES",
        "WHATSAPP_ACK_TEMPLATE",
        "WHATSAPP_OPS_TEMPLATE",
        "WHATSAPP_OPS_NUMBERS",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "OPS_EMAILS",
        "SUMMARY_EMAILS",
        "SHEET_WEBHOOK_URL",
        "SHEET_WEBHOOK_SECRET",
        "GA4_MEASUREMENT_ID",
        "GA4_API_SECRET",
        "CRON_SECRET"
      ]
    },
    "typecheck": {
      "env": ["NEXT_PUBLIC_*"]
    },
    "dev": {
      "passThroughEnv": [
        "NEXT_PUBLIC_*",
        "SUPABASE_URL",
        "SUPABASE_PUBLISHABLE_KEY",
        "SUPABASE_SITE_SECRET",
        "SUPABASE_SECRET_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",
        "SENTRY_DSN",
        "SENTRY_ENVIRONMENT",
        "GOOGLE_MAPS_API_KEY",
        "TURNSTILE_SECRET_KEY",
        "TURNSTILE_HOSTNAMES",
        "RATE_LIMIT_SALT",
        "ALLOW_SAMPLE_DATA",
        "WHATSAPP_CLOUD_TOKEN",
        "WHATSAPP_PHONE_NUMBER_ID",
        "WHATSAPP_TRANSPORTER_TEMPLATE",
        "PREVIEW_UNREVIEWED_LOCALES",
        "WHATSAPP_ACK_TEMPLATE",
        "WHATSAPP_OPS_TEMPLATE",
        "WHATSAPP_OPS_NUMBERS",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "OPS_EMAILS",
        "SUMMARY_EMAILS",
        "SHEET_WEBHOOK_URL",
        "SHEET_WEBHOOK_SECRET",
        "GA4_MEASUREMENT_ID",
        "GA4_API_SECRET",
        "CRON_SECRET"
      ]
    },
    "test:e2e": {
      "env": [
        "NEXT_PUBLIC_*",
        "SUPABASE_URL",
        "SUPABASE_PUBLISHABLE_KEY",
        "SUPABASE_SITE_SECRET",
        "SUPABASE_SECRET_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",
        "SENTRY_DSN",
        "SENTRY_ENVIRONMENT",
        "GOOGLE_MAPS_API_KEY",
        "TURNSTILE_SECRET_KEY",
        "TURNSTILE_HOSTNAMES",
        "RATE_LIMIT_SALT",
        "ALLOW_SAMPLE_DATA",
        "PREVIEW_UNREVIEWED_LOCALES",
        "WHATSAPP_ACK_TEMPLATE",
        "WHATSAPP_OPS_TEMPLATE",
        "WHATSAPP_OPS_NUMBERS",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "OPS_EMAILS",
        "SUMMARY_EMAILS",
        "SHEET_WEBHOOK_URL",
        "SHEET_WEBHOOK_SECRET",
        "GA4_MEASUREMENT_ID",
        "GA4_API_SECRET",
        "CRON_SECRET"
      ],
      "passThroughEnv": ["E2E_PORT"]
    },
    "lhci": {
      "cache": false,
      "env": ["LHCI_BASE_URL", "CHROME_PATH"]
    }
  }
}
