{
  "extends": "@truckbuck/config-typescript/nextjs.json",
  "compilerOptions": {
    // next.config.ts is loaded by Node's native TS support, which needs
    // explicit `.ts` extensions on relative imports.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next/standalone"]
}
