{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "marketing-dev",
      "url": "http://localhost:3000",
      "port": 3000
    },
    {
      "name": "marketing-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "-y",
        "pnpm@12.16.1",
        "--filter",
